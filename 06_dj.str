// =============================================================================
// 06: LIVE DINNER LOUNGE SET (Chill Neo-Soul, Jazz & Lofi Ambient)
// =============================================================================
//
// 🍷 DINNER & WINE BAR ATMOSPHERE:
//   Zero techno, zero harsh synths, zero loud kicks.
//   Soft Fender Rhodes jazz chords, warm acoustic upright bass, subtle
//   brushed rimshots, and mellow vibes at a relaxed 78–88 CPM.
//   Perfect for dinner conversation, clinking wine glasses, and cozy ambiance.
//
// 🎛️ CONTROLS:
//   <leader>ml : :StrudelLaunch (Connect to Strudel engine)
//   <leader>mp : :StrudelToggle (Play / Pause audio)
//   <leader>mu : :StrudelUpdate (UPDATE CHANGES LIVE — Press after each move!)
//
// 🎹 LIVE DJ ACTIONS:
//   gcc        : Toggle comment on a line (introduce / mute layer with 1 tap)
//   vip then d : Delete current song paragraph to transition to next song
//   vip then gc: Uncomment next song block instantly
// =============================================================================


// =============================================================================
// 🕯️ TRACK 1: "CANDLELIGHT LOUNGE" (Mellow Jazz & Neo-Soul — 78 CPM)
// =============================================================================
// Starts with ZERO drums — just warm, floating Fender Rhodes jazz chords.
// Press <leader>mp to start. Uncomment layers with gcc, then hit <leader>mu!


// =============================================================================
// 🍷 TRACK 2: "ROOFTOP WINE BAR" (Bossa & Chillhop — 84 CPM)
// =============================================================================
// TO SWITCH:
//   1. Move cursor into Track 1 above, press: vip then d
//   2. Move cursor into Track 2 below, press: vip then gc (uncomments whole block!)
//   3. Press <leader>mu -> Track 2 enters smoothly with silky chords and NO drums!
// =============================================================================


// =============================================================================
// ☕ TRACK 3: "LATE NIGHT ESPRESSO" (Midnight Coffeehouse — 88 CPM)
// =============================================================================
// GRAND FINALE TRANSITION:
//   1. Move cursor into Track 2 above, press: vip then d
//   2. Move cursor into Track 3 below, press: vip then gc
//   3. Press <leader>mu to finish the dinner set!
// =============================================================================

stack(
  // 1. [ATMOSPHERE] Dreamy major-9th progression (ACTIVE)
  note("<[f3,a3,c4,e4] [e3,g3,b3,d4] [d3,f3,a3,c4] [c3,e3,g3,b3]>")
    .s("triangle")
    .lpf(950)
    .room(0.8)
    .slow(4)
    .gain(0.35),

  // 2. [MELODY] Cozy melodic lead (Press gcc here)
  note("e4 ~ g4 ~ a4 ~ c5 ~").s("sine").lpf(1100).delay(0.35).slow(2).gain(0.25),

  // 3. [BASS] Deep cozy acoustic bass (Press gcc here)
  note("<f1 e1 d1 c1>").s("sine").lpf(300).gain(0.45),

  // 4. [PERCUSSION] Soft brushed snare (Press gcc here)
  s("~ cp ~ cp").lpf(1200).room(0.5).gain(0.22),

  // 5. [ANCHOR BEAT] Gentle chillhop kick (Press gcc here)
  s("bd ~ ~ bd").lpf(350).gain(0.4),
).cpm(88)
