// =============================================================================
// Starts minimal. Press <leader>mp to play, then uncomment layers with `gcc`
// and press <leader>mu after each layer to build the energy to the peak!

stack(
  // [Step 1] - Minimal kick foundation (ACTIVE BY DEFAULT)
  s("bd*4").gain(1.15),

