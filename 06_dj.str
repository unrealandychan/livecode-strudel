// =============================================================================
// 06: LIVE DJ SET — SIMPLE 3-TRACK PERFORMANCE
// =============================================================================
//
// 🎛️ CONTROLS:
//   <leader>ml : :StrudelLaunch (Connect)
//   <leader>mp : :StrudelToggle (Play / Pause)
//   <leader>mu : :StrudelUpdate (UPDATE LIVE CHANGES)
//
// 🎹 LIVE DJ ACTIONS:
//   gcc        : Uncomment / comment a line (easy single keystroke)
//   vip + d    : Delete current track to switch to the next one
//   vip + gc   : Uncomment the next track
// =============================================================================


// =============================================================================
// 🌙 SONG 1: CHILL DUB (Slow — 100 CPM)
// =============================================================================
// Starts gentle & slow with just a soft synth arp.
// Uncomment step 2, 3, and 4 (the beat) one by one, then press <leader>mu!

stack(
  // 1. Soft ambient synth arp (starts active, gentle & quiet)
  note("c3 eb3 g3 c4")
    .s("sine")
    .room(0.7)
    .gain(0.4),

  // 2. Warm deep sub-bass (uncomment with gcc)
  // note("c2 ~ eb2 ~")
  //   .s("sawtooth")
  //   .lpf(400)
  //   .gain(0.5),

  // 3. Subtle hat & rim groove (uncomment with gcc)
  // s("~ hh ~ rim")
  //   .gain(0.3),

  // 4. Anchor beat: Gentle kick (uncomment to drop the beat!)
  // s("bd ~ bd ~")
  //   .gain(0.6),
).cpm(100)


// =============================================================================
// 🌇 SONG 2: WARM MELODIC GROOVE (115 CPM)
// =============================================================================
// TO SWITCH: Delete Song 1 above (`vip` then `d`), uncomment this block
// (`vip` then `gc`), and hit <leader>mu!
// =============================================================================
