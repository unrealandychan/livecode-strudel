// =============================================================================
// 06: LIVE DJ SET — SIMPLE 3-TRACK PERFORMANCE (SLOW & CHILL)
// =============================================================================
//
// 🎛️ CONTROLS:
//   <leader>ml : :StrudelLaunch (Connect to Strudel engine)
//   <leader>mp : :StrudelToggle (Play / Pause audio)
//   <leader>mu : :StrudelUpdate (UPDATE CHANGES LIVE — Press after uncommenting!)
//
// 🎹 LIVE DJ ACTIONS:
//   gcc        : Toggle comment on current line (introduce / mute layer with 1 tap)
//   vip then d : Delete current song paragraph to make room for next song
//   vip then gc: Uncomment next song block instantly
// =============================================================================


// =============================================================================
// 🌙 SONG 1: CHILL DUB (Slow & Spacious — 100 CPM)
// =============================================================================
// Starts gentle with just a soft synth arp.
// Press gcc on lines 28, 31, and 34, then press <leader>mu!

stack(
  // 1. Soft ambient synth arp (ACTIVE BY DEFAULT)
  note("c3 eb3 g3 c4").s("sine").room(0.7).gain(0.4),

  // 2. Warm deep sub-bass (Press gcc here)
  // note("c2 ~ eb2 ~").s("sawtooth").lpf(400).gain(0.5),

  // 3. Subtle hat & rim groove (Press gcc here)
  // s("~ hh ~ rim").gain(0.3),

  // 4. Anchor beat: Gentle kick (Press gcc here to drop the beat!)
  // s("bd ~ bd ~").gain(0.6),
).cpm(100)


