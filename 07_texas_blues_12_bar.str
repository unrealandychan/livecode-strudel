// =============================================================================
// 07: 12-BAR TEXAS BLUES GUITAR BACKING TRACK (Key of E)
// =============================================================================
// Inspired by: Stevie Ray Vaughan ("Texas Flood"), Albert King, and Buddy Guy.
//
// 🎸 GUITAR JAMMING GUIDE (KEY OF E):
// -----------------------------------------------------------------------------
// 1. E Minor Pentatonic (The Essential Blues Box 1, 12th Fret):
//    e |----------------------------12--15--|  (E, G)
//    B |--------------------12--15----------|  (B, D)
//    G |------------12--14------------------|  (G, A)
//    D |----12--14--------------------------|  (D, E)
//    A |----12--14--------------------------|  (A, B)
//    E |--12--15----------------------------|  (E, G)
//
// 2. The Blue Note (Bb / Flat 5):
//    Bend 14th fret G up half-step toward 15, or hit 15th fret on A / B string.
//
// 3. 12-Bar Blues Form:
//    Bars 1–4  : [E7] [E7] [E7] [E7]   -> Home / Slow moody intro
//    Bars 5–6  : [A7] [A7]             -> The IV Chord lift (dig into bends!)
//    Bars 7–8  : [E7] [E7]             -> Back Home
//    Bar 9     : [B7]                  -> The V Chord (Peak tension & crying bends!)
//    Bar 10    : [A7]                  -> Resolving IV Chord
//    Bar 11    : [E7]                  -> Home
//    Bar 12    : [B7]                  -> The Turnaround (brings it back to Bar 1)
//
// 🎛️ CONTROLS (<leader> = Space):
//   <leader>ml : :StrudelLaunch (Launch Strudel engine)
//   <leader>mp : :StrudelToggle (Play / Pause backing track)
//   <leader>mu : :StrudelUpdate (Apply changes live)
//   gcc        : Toggle mute on any instrument layer
// =============================================================================


// =============================================================================
// 🌧️ MAIN TRACK: SLOW BURNING TEXAS BLUES (64 CPM — "Texas Flood" Style)
// =============================================================================
// Spaced-out 12/8 slow blues ballad. Zero drum clutter, tons of emotional space.
// Press <leader>mp to start jamming!

stack(
  // 1. Minimal heartbeat kick: Just ONE gentle pulse on beat 1 (warm & quiet)
  s("bd ~ ~ ~")
    .lpf(300)
    .gain(0.5),

  // 2. Slow deep snare on beat 3 with rich hall reverb
  s("~ ~ sd ~")
    .room(0.7)
    .gain(0.65),

  // 3. Gentle 12/8 triplet hi-hat pulse (soft acoustic brushes feel)
  s("hh*6")
    .gain(0.26),

  // 4. Slow walking bassline (warm tube-amp tone, lots of breathing room)
  note("<[e1 ~ gs1 ~ b1 ~ cs2 ~]!4 [a1 ~ cs2 ~ e2 ~ fs2 ~]!2 [e1 ~ gs1 ~ b1 ~ cs2 ~]!2 [b1 ~ ds2 ~ fs2 ~ gs2 ~] [a1 ~ cs2 ~ e2 ~ fs2 ~] [e1 ~ gs1 ~ b1 ~ cs2 ~] [b1 ~ ds2 ~ fs2 ~ gs2 ~]>")
    .s("triangle")
    .lpf(350)
    .decay(0.7)
    .gain(0.65),

  // 5. Warm blues chords (Fender Twin Reverb sound holding the harmony)
  note("<[e3,gs3,d4]!4 [a3,cs4,g4]!2 [e3,gs3,d4]!2 [b3,ds4,a4] [a3,cs4,g4] [e3,gs3,d4] [b3,ds4,a4]>")
    .s("triangle")
    .lpf(1200)
    .room(0.8)
    .decay(0.8)
    .gain(0.4),

  // 6. Hammond B3 Organ: Lush sustained Leslie chords (Press gcc here to enable!)
  // note("<[e3,b3,d4,gs4]!4 [a2,g3,cs4,e4]!2 [e3,b3,d4,gs4]!2 [b2,a3,ds4,fs4] [a2,g3,cs4,e4] [e3,b3,d4,gs4] [b2,a3,ds4,fs4]>")
  //   .s("sine")
  //   .lpf(1200)
  //   .room(0.85)
  //   .gain(0.32),
).cpm(64)


// =============================================================================
