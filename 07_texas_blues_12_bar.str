// =============================================================================
// 07: 12-BAR TEXAS BLUES — LIVE-BUILDING BACKING TRACK (Key of E)
// =============================================================================
// Inspired by: Stevie Ray Vaughan ("Texas Flood"), Albert King, and Buddy Guy.
//
// 🎸 GUITAR JAMMING GUIDE (KEY OF E):
// -----------------------------------------------------------------------------
// 1. E Minor Pentatonic (Essential Blues Box 1, 12th Fret):
//    e |----------------------------12--15--|  (E, G)
//    B |--------------------12--15----------|  (B, D)
//    G |------------12--14------------------|  (G, A)
//    D |----12--14--------------------------|  (D, E)
//    A |----12--14--------------------------|  (A, B)
//    E |--12--15----------------------------|  (E, G)
//
// 2. The Blue Note (Bb / Flat 5):
//    15th fret on A, 13th fret on G, or bend 14th fret G slightly sharp.
//
// 3. 12-Bar Blues Form:
//    Bars 1–4  : [E7] [E7] [E7] [E7]   -> Intro / Moody home
//    Bars 5–6  : [A7] [A7]             -> The IV Chord lift (dig into bends!)
//    Bars 7–8  : [E7] [E7]             -> Back Home
//    Bar 9     : [B7]                  -> The V Chord (Peak tension!)
//    Bar 10    : [A7]                  -> Resolving IV Chord
//    Bar 11    : [E7]                  -> Home
//    Bar 12    : [B7]                  -> The Turnaround (pulls back to Bar 1)
//
// 🎛️ CONTROLS (<leader> = Space in Neovim):
//   <leader>ml : :StrudelLaunch (Launch Strudel engine)
//   <leader>mp : :StrudelToggle (Play / Pause backing track)
//   <leader>mu : :StrudelUpdate (APPLY LIVE CHANGES — Press after uncommenting!)
//   gcc        : Toggle comment on current line (1 tap to introduce a layer!)
// =============================================================================


// =============================================================================
// 🌧️ MAIN TRACK: SLOW BURNING TEXAS BLUES (64 CPM — "Texas Flood" Style)
// =============================================================================
// LIVE-BUILDING FLOW:
//   Starts with ONLY Layer 1 active (gentle blues chords with hall reverb).
//   Play your intro guitar solo over the chords, then introduce layers one-by-one
//   using `gcc` followed by `<leader>mu`!

stack(
  // [Step 1 - ACTIVE BY DEFAULT] Warm blues chords (Fender Twin Reverb sound)
  note("<[e3,gs3,d4]!4 [a3,cs4,g4]!2 [e3,gs3,d4]!2 [b3,ds4,a4] [a3,cs4,g4] [e3,gs3,d4] [b3,ds4,a4]>")
    .s("triangle")
    .lpf(1200)
    .room(0.8)
    .decay(0.8)
    .gain(0.42),

  // [Step 2 - BASS] Slow walking bassline (Press gcc here)
  // note("<[e1 ~ gs1 ~ b1 ~ cs2 ~]!4 [a1 ~ cs2 ~ e2 ~ fs2 ~]!2 [e1 ~ gs1 ~ b1 ~ cs2 ~]!2 [b1 ~ ds2 ~ fs2 ~ gs2 ~] [a1 ~ cs2 ~ e2 ~ fs2 ~] [e1 ~ gs1 ~ b1 ~ cs2 ~] [b1 ~ ds2 ~ fs2 ~ gs2 ~]>").s("triangle").lpf(350).decay(0.7).gain(0.65),

  // [Step 3 - HATS] Gentle 12/8 triplet brushes (Press gcc here)
  // s("hh*6").gain(0.26),

  // [Step 4 - SNARE] Slow deep backbeat snare with hall reverb (Press gcc here)
  // s("~ ~ sd ~").room(0.7).gain(0.65),

  // [Step 5 - ANCHOR KICK] Heartbeat kick — just ONE soft pulse on 1 (Press gcc here!)
  // s("bd ~ ~ ~").lpf(300).gain(0.5),

  // [Step 6 - ORGAN] Hammond B3 Leslie organ pad (Press gcc here for extra warmth!)
  // note("<[e3,b3,d4,gs4]!4 [a2,g3,cs4,e4]!2 [e3,b3,d4,gs4]!2 [b2,a3,ds4,fs4] [a2,g3,cs4,e4] [e3,b3,d4,gs4] [b2,a3,ds4,fs4]>").s("sine").lpf(1200).room(0.85).gain(0.32),
).cpm(64)


// =============================================================================
