// ==========================================
// 04: FULL PERFORMANCE TRACK (Algorave Jam)
// ==========================================
// A complete multi-layered track combining drums, bassline, and arps.

stack(
  // 1. Kick drum
  s("bd*4")
    .gain(1.2),

  // 2. Crisp hi-hats with velocity variation
  s("hh*16")
    .gain(sine.range(0.3, 0.8).fast(4))
    .pan(perlin.range(0.2, 0.8)),

  // 3. Snare / Clap with reverb
  s("~ [sd,cp] ~ [sd,cp]")
    .room(0.5)
    .gain(0.9),

  // 4. Acid bassline
  note("c2 [c2 eb2] f2 [g2 bb2]")
    .s("sawtooth")
    .lpf(sine.range(400, 2800).slow(4))
    .resonance(12)
    .decay(0.2)
    .gain(0.85),

  // 5. Ambient arpeggiated lead
  note("<[c4 eb4 g4] [bb3 d4 f4] [ab3 c4 eb4] [g3 b3 d4]>")
    .s("square")
    .lpf(1400)
    .delay(0.5)
    .delaytime(0.25)
    .room(0.8)
    .gain(0.4)
).cpm(126)
