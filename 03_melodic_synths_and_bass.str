// ==========================================
// 03: MELODIC SYNTHS, BASS & EFFECTS
// ==========================================
// Strudel supports software synths (sawtooth, square, triangle, sine)
// and musical scales / notes.
//
// Tip: Use line comments (//) to toggle or swap layers live!
// Press <leader>mu (or :StrudelUpdate) after editing to apply changes.

stack(
  // 1. Simple punchy sawtooth bassline:
  note("c2 eb2 f2 g2")
    .s("sawtooth")
    .lpf(800) // low-pass filter at 800Hz
    .decay(0.3),

  // 2. Ambient chords & arpeggios:
  note("<[c3,eb3,g3] [bb2,d3,f3] [ab2,c3,eb3] [g2,b2,d3]>")
    .s("triangle")
    .room(0.8) // big reverb
    .delay(0.4) // echo
    .slow(2),

  // 3. Acid bassline with resonant filter sweep (comment #1 and uncomment this to switch!):
  // note("c1 [eb1 g1] bb1 c2")
  //   .s("sawtooth")
  //   .cutoff(sine.range(300, 2500).slow(8)) // filter sweeps up and down
  //   .resonance(15)
  //   .decay(0.15),

  // 4. Arpeggiated square-wave lead:
  // note("c4 eb4 g4 bb4")
  //   .s("square")
  //   .lpf(1400)
  //   .decay(0.2)
  //   .delay(0.25)
  //   .gain(0.5),

  // 5. Optional beat to anchor the synths:
  // s("bd*4").gain(0.8),
).cpm(124)
